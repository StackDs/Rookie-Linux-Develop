#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: no
  interactive-sections:
    - network
    - storage
    - identity
    - locale
    - timezone
    - keyboard
  locale: en_US.UTF-8
  keyboard:
    layout: us

  late-commands:
    # 1. Mover nuestros scripts desde la ISO (/cdrom) al disco duro instalado (/target/opt/)
    - cp -r /cdrom/custom_scripts /target/opt/rookie-scripts
    - curtin in-target -- find /opt/rookie-scripts/scripts/ -name "*.sh" -exec chmod +x {} +
    - chmod +x /target/opt/rookie-scripts/rookie-firstboot.sh
    - chmod +x /target/opt/rookie-scripts/rookie-terminal-wrapper.sh
    
    # 2. Configurar autostart para el primer inicio de sesión
    - mkdir -p /target/etc/xdg/autostart
    - cp /target/opt/rookie-scripts/rookie-firstboot.desktop /target/etc/xdg/autostart/
    - chmod 644 /target/etc/xdg/autostart/rookie-firstboot.desktop
    
    # 3. Desactivar cloud-init en el sistema instalado para que no se ejecute en cada arranque
    - curtin in-target -- touch /etc/cloud/cloud-init.disabled
    
    # 4. Limpiar nomodeset del GRUB instalado (por si se propagó desde el USB)
    - curtin in-target -- sed -i 's/ nomodeset//g' /etc/default/grub || true
    - curtin in-target -- update-grub || true
