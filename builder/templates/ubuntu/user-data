#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: no
  interactive-sections:
    - network
    - storage
    - identity
  locale: en_US.UTF-8
  keyboard:
    layout: us

  late-commands:
    # 1. Mover nuestros scripts desde la ISO (/cdrom) al disco duro instalado (/target/opt/)
    - cp -r /cdrom/custom_scripts /target/opt/rookie-scripts
    - chmod +x /target/opt/rookie-scripts/scripts/*.sh
    
    # 2. Ejecutar la bateria de scripts (install.sh) "chrootando" al sistema recien instalado
    # Todo el log de instalacion se enviara a /var/log/rookie-install.log
    - curtin in-target -- bash -c "/opt/rookie-scripts/scripts/install.sh > /var/log/rookie-install.log 2>&1"
